    {
      "id": 292663,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eحوثی‌های یمن مسئولیت حمله به تأسیسات شرکت نفتی آرامکوی عربستان را به عهده گرفتند\u003cbr/\u003e\u003cbr/\u003eبه گزارش خبرگزاری‌ها حوثی‌های یمن مسئولیت حمله به تأسیسات شرکت آرامکو در ریاض، پایتخت عربستان سعودی، را به عهده گرفته و گفته‌اند که با موشک‌های بالستیک و پهپاد آن را هدف قرار داده‌اند.\u003cbr/\u003e\u003cbr/\u003eحوثی‌ها گفته‌اند که این حمله در تلافی حملات عربستان به صنعا و دیگر مناطق یمن صورت گرفته است.\u003cbr/\u003e\u003cbr/\u003eیک شاهد عینی به خبرگزاری رویترز گفت که اوایل روز شنبه، ستون بزرگی از دود و آتش در نزدیکی یکی از تأسیسات آرامکو در ریاض مشاهده شده است.\u003cbr/\u003e\u003cbr/\u003eمقامات عربستان سعودی هنوز انجام این حمله به تأسیسات آرامکو را تایید نکرده‌اند و شرکت آرامکو نیز بلافاصله به درخواست اظهار نظر در این باره پاسخی نداده است.\u003cbr/\u003e\u003cbr/\u003eاین حمله در حالی گزارش می‌شود که تنش‌ میان عربستان سعودی و حوثی‌ها شدت گرفته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/46YbbRW\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/46YbbRW\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
