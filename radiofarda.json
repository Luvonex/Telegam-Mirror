    {
      "id": 162253,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003eمصطفی مهرآیین از منتقدان جمهوری اسلامی به زندان منتقل شد.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003eدر سال‌های اخیر در گفت‌وگو با رسانه‌ها از مواضع و رویدکرد جمهوری اسلامی انتقاد کرده بود.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003eدادگاه انقلاب این جامعه‌شناس را به اتهامهایی از جمله «اجتماع و تبانی لیه امنیت کشور» « تبلیغ علیه نظام» و «اهانت به رهبری» محکوم کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003eمصطفی مهرآیین، استادیار جامعه‌شناسی پژوهشگاه علوم انسانی و مطالعات فرهنگی، در ماه‌های منتهی به بازداشت خود در سال گذشته با انتشار چند نامهٔ سرگشاده خطاب به علی خامنه‌ای، رهبر سابق جمهوری اسلامی، خواستار کناره‌گیری او از قدرت شده بود.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003eآقای مهرآئین در مجموع به ۸ سال زندان محکوم شده که ۵ سال آن قابل اجراست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/RadioFarda\" target=\"_blank\"\u003e@RadioFarda\u003c/a\u003e",
