    {
      "id": 150350,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eچوب حراج به جنگل هیرکانی توسط منابع طبیعی!\u003cbr/\u003e\u003cbr/\u003eمتولی منابع طبیعی کشور برای ۸ متر مکعب چوب بلوط ⁧ \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%D9%84_%D9%87%DB%8C%D8%B1%DA%A9%D8%A7%D9%86%DB%8C\"\u003e#جنگل_هیرکانی\u003c/a\u003e ⁩  ۱۳۳ میلیون تومان جریمه تعیین کرده در حالیکه قیمت هر مترمکعب از این چوب در بازار بین ۳۰۰ تا ۳۷۵ میلیون تومان هست!\u003cbr/\u003e‏اگر این مصداق بارز چوب حراج نیست پس چیست؟ \u003cbr/\u003e‏چرا متولی حفاظت به مجرم چنین تخفیفی داده؟\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eچراغ سبز متولیان منابع طبیعی به قاچاق چیان منفعت مالی برای هر دو دارد\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
