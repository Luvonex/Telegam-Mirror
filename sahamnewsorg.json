    {
      "id": 149511,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eآسوشیتدپرس: مردم تهران درحال ذخیره غذا و دارو هستن و آماده شدن تا درصورت وقوع جنگ فرار کنن به شمال کشور. چون فکر میکنن اونجا امن تره\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
