    {
      "id": 148110,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eکانال ۱۳ اسراییل، نزدیک به جناح مخالفان نتانیاهو، می‌گوید دیدار  دیروز بنیامین نتانیاهو، نخست‌وزیر این کشور، با رئیس‌ امارات در ابوظبی حدود شش‌ساعت به‌طول انجامیده و تمرکز اصلی آن بر روی جنگ آتی با ایران بوده\u003c/b\u003e \u003cb\u003eاست\u003c/b\u003e. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-09-28T06:50:15Z",
