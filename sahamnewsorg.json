    },
    {
      "id": 149172,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eتأیید ضمنی جنگ قریب‌الوقوع میان ایران و اسرائیل توسط آمریکا،\u003cbr/\u003eروزنامه دولتی الاخبار لبنان اعلام کرد\u003cbr/\u003e\u003cbr/\u003eوزیر خارجه آمریکا در تماسی غیر عادی به رئیس‌جمهور لبنان و نخست‌وزیر این کشور،\u003cbr/\u003eپیامی شدید داده است که در صورت ورود حزب‌الله به جنگ میان اسرائیل و ایران،\u003cbr/\u003eلبنان با واکنشی گسترده و شدید روبه‌رو خواهد شد؛\u003cbr/\u003eواکنشی که به گفته یک مقام ارشد دولتی لبنان،\u003cbr/\u003eتمام محدودیت‌های قبلی را درخواهد نوردید.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-10-19T11:52:46Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 33200,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "سهام نیوز"
    },
    {
      "id": 149173,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eورود روس‌ها شر است اما....! \u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C8D.png\u0026#39;)\"\u003e\u003cb\u003e✍️\u003c/b\u003e\u003c/i\u003eاحمد زیدآبادی\u003cbr/\u003eاگر سرگئی لاوروف وزیر خارجهٔ روسیه در سفرش به تهران حامل طرحی برای پایان جنگ بین آمریکا و ایران باشد، عموم تصمیم‌گیران کشور لازم است با روی باز از آن استقبال کنند.\u003cbr/\u003e\u003cbr/\u003eمن بشخصه آرزو می‌کردم که روس‌ها از این مناقشه دور نگه‌داشته شوند و ایران و آمریکا خود راهی معقول و متوازن برای رفع خصومت پیدا کنند.\u003cbr/\u003eحال که ناتوانی دو طرف اصلی مناقشه برای رفع تشنج آشکار شده است، دخالت روس‌ها می‌تواند فرصتی برای دیپلماسی محسوب شود.\u003cbr/\u003e\u003cbr/\u003eدخالت روس‌ها البته شر است اما نسبت به وقوع دوبارهٔ جنگ، شر کوچکتری است! بنابراین استقبال از شر کمتر در برابر شر بیشتر اقتضای عقل‌سلیم است، البته اگر اثری از عقل‌سلیم باقی مانده باشد! \u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-10-19T11:58:04Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 32700,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "سهام نیوز"
    },
    {
      "id": 149174,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eمدیرعامل هما: ۹ هزار کارمند برای ۷ هواپیمای فعال داریم\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eتمام سازمانها و ادارات دولتی و حکومتی همین وضعیت را دارند.\u003cbr/\u003eاز سال ۸۴ میلیونها نفر را استخدام مراکز دولتی و حکومتی کردند که در یک فقره به تعبیر اقای زنگنه وزیر سابق نفت ۱۲۰ هزار نفر استخدام وزارت نفت می شوند \u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-10-19T12:21:40Z",
