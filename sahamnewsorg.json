    {
      "id": 149466,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eقیمت بنزین سوپر داخلی لیتری ۱۰۳ هزار تومان اعلام شد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eحمید حبیبی، مدیر بازرگانی شرکت ملی پخش فرآورده‌های نفتی ایران:\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eپس از ارائه پیشنهادهای لازم به دولت و تصویب امکان تولید و عرضه داخلی بنزین سوپر، تولید این فرآورده در پالایشگاه ستاره خلیج فارس و پالایشگاه شازند آغاز شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eقیمت هر لیتر بنزین سوپر در جایگاه‌های عرضه‌کننده بین ۱۰۳ تا ۱۱۰ هزار تومان است.\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
