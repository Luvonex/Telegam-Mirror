    },
    {
      "id": 149214,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eشیخ سعود آل‌ثانی، وزیر دفاع قطر، درباره ایران:\u003cbr/\u003e\u003cbr/\u003eآلمان و فرانسه نزدیک به ۷۵ سال با یکدیگر درگیر بودند و سه جنگ بزرگ میان آن‌ها رخ داد.\u003cbr/\u003eاما پس از آن، تصمیم گرفتند روابط اقتصادی برقرار کنند. این روند در سال ۱۹۷۰ با ایرباس آغاز شد.\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eما می‌خواهیم پلی ارتباطی ایجاد کنیم تا از روابط اقتصادی برای جلوگیری از هرگونه درگیری استفاده کنیم.\u003c/b\u003e\u003cbr/\u003eزیرا ایران همسایه ماست. ما باید راه‌هایی پیدا کنیم تا از وقوع هر نوع درگیری در آینده جلوگیری کنیم.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
