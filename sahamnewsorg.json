    {
      "id": 148147,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eتغییر نام ۲ خیابان قدیمی مشهد از کوهسنگی و دانشگاه به خامنه ای اول\u003cbr/\u003e\u003cbr/\u003eشورای شهر مشهد معلوم نیست چه هدفی دارد که بدون اجازه ⁧ بیت ⁩ و با وجود رد مصوبه توسط ⁧ فرمانداری مشهد ⁩ ،نام دو خیابان قدیمی و نوستالوژی مشهد را از ⁧ \u003ca href=\"?q=%23%DA%A9%D9%88%D9%87%D8%B3%D9%86%DA%AF%DB%8C\"\u003e#کوهسنگی\u003c/a\u003e ⁩ و ⁧ \u003ca href=\"?q=%23%D8%AF%D8%A7%D9%86%D8%B4%DA%AF%D8%A7%D9%87\"\u003e#دانشگاه\u003c/a\u003e ⁩ به امام شهید ⁧ خامنه ای ⁩ تغییر دادند...\u003cbr/\u003e‏منصوریان ⁧ \u003ca href=\"?q=%23%D8%B4%DB%8C%D8%AE_%D8%A7%D8%B5%D9%81%D9%87%D8%A7%D9%86%DB%8C\"\u003e#شیخ_اصفهانی\u003c/a\u003e ⁩ شورای شهر گفته اسم راتغییر دادیم،بقیه اش به مامربوط نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
