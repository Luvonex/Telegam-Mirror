    {
      "id": 147808,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e۳هزار دستگاه ماینر بیش از ۷۰ درصد برق شهرک صنعتی بهبهان را مصرف می‌کردند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eمدیرعامل توانیر اعلام کرد \u003cbr/\u003eدر شهرک صنعتی بهبهان حدود ۳ هزار دستگاه ماینر شناسایی شده که بیش از ۷۰ درصد مصرف برق این شهرک را به خود اختصاص داده بودند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
