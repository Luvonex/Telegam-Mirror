    },
    {
      "id": 148479,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eعلیرضا سپاهی و علیرضا رئیسی اعدام شدند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eشهرزاد شهبازی، وکیل علیرضا سپاهی، اعلام کرد موکلش بامداد امروز در زندان اصفهان اعدام شده است. او گفت با وجود تجویز اعاده دادرسی در دیوان عالی، شعبه دوم دادگاه انقلاب اصفهان بدون برگزاری جلسه و در کمتر از ۴۸ ساعت درخواست اعاده دادرسی را رد کرده است.\u003cbr/\u003e\u003cbr/\u003eهمزمان، گزارش‌های غیررسمی به نقل از خانواده علیرضا رئیسی، از دیگر متهمان این پرونده، حاکی از اعدام او نیز در صبح امروز است.\u003cbr/\u003e\u003cbr/\u003eسپاهی شب گذشته در زندان با مهشاد کشانی، دیگر زندانی اعتراضات دی ۱۴۰۴ که به پنج سال حبس محکوم شده، ازدواج کرده بود. امیرسالار داوودی، وکیل دادگستری، با انتشار فایل صوتی خطبه عقد این دو، خبر ازدواج‌شان را اعلام کرد. آنها پیش از بازداشت نامزد بودند.\u003cbr/\u003e\u003cbr/\u003eسپاهی پیش‌تر نیز هنگام انتقال برای اجرای حکم دچار عارضه قلبی شده و به بیمارستان منتقل شده بود. با اعدام او و رئیسی، شمار اعدام‌شدگان پرونده اعتراضات میدان علیخانی اصفهان به هشت نفر رسیده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-10-05T08:04:50Z",
