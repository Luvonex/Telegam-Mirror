    },
    {
      "id": 147620,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eحسین الله‌کرم رئیس شورای هماهنگی انصار حزب‌الله: با همین وفاق جنگ اتفاق افتاد و در همین چارچوب پزشکیان را عامل جنگ می‌دانم در حالی‌ که اگر جلیلی رئیس‌جمهور بود جنگ اتفاق نمی‌افتاد.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C8D.png\u0026#39;)\"\u003e\u003cb\u003e✍️\u003c/b\u003e\u003c/i\u003eمجید مرادی\u003cbr/\u003eالله کرم با همین فرمان به عقب برگردد می‌تواند بگوید اگر شاه سرنگون نشده بود اصلا جنگ هشت ساله و تحریم و فلاکت و دو جنگ اخیر هم اتفاق نمی‌افتاد که قطعا درست است.\u003cbr/\u003eالبته ایشان یادشان نیست که جنگ در ۷ اکتبر در سال ۱۴۰۲ و زمان رئیسی راه افتاد نه در زمان پزشکیان!\u003cbr/\u003e \u003cbr/\u003eساختمان سفارت ایران در سوریه هم در زمان رئیسی بمباران شد که به منزله اعلام جنگ بود. \u003cbr/\u003eاین جمله الله کرم را خود جلیلی هم بخواند خنده‌اش می‌گیرد چون جلیلی اساسا به جنگ درمانی معتقد است. هم دو با جیم شروع می‌شوند. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
