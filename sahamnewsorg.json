    },
    {
      "id": 148480,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eانتخاب اعضای هیات‌ رئیسه جبهه اصلاحات ایران برگزار شد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eپنج عضو هیأت‌ رئیسه جبهه اصلاحات ایران در جلسه مجمع عمومی جبهه برای دومین سال از دوره سوم فعالیت آن انتخاب شدند.\u003cbr/\u003e\u003cbr/\u003eبر اساس نتایج این انتخابات، آذر منصوری، محسن آرمین، سیدحسن رسولی، بدرالسادات مفیدی و جواد امام به‌ترتیب به‌عنوان رئیس، نایب‌رئیس اول، نایب‌رئیس دوم، دبیر و سخنگوی جبهه اصلاحات ایران انتخاب شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
