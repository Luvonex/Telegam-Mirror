    },
    {
      "id": 147648,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eافشاگری بزرگ یاشار سلطانی از فساد جوجه امنیتی ها تا حسین شمخانی و روح الله رضوی در نفت\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eکشور بی صاحب شده خاک بر سر وزیر نفت تنها کاری که نمی کنه فروش نفته\u003cbr/\u003e\u003cbr/\u003eکجای دنیا نفت در اختیار امنیتی ها قرار می گیرد؟ فروش نفت در اختیار چند تا جوجه اطلاعاتی قرار گرفته است\u003cbr/\u003e\u003cbr/\u003eاینها همان کسانی هستند که وقتی رییس جمهور در عراقه و رییس مجلس در مشهد و پیکر در هواست موشک می زنند به۳ تا کشتی تا تفاهم نامه را به هم بزنند\u003cbr/\u003e\u003cbr/\u003eروح الله رضوی داماد سخنگوی جبهه پایداری جزو آن ۴ نفری است که ۸۵ میلیون بشکه نفت در اختیارشان قرار گرفته است. رضوی تا الان ۱۷ میلیارد دلار نفت فروخته است\u003cbr/\u003e\u003cbr/\u003eحسین شمخانی بالای ۳۰ میلیارد دلار نفت فروخته یعنی بالای چندین برابر ثروت ترامپ\u003cbr/\u003e\u003cbr/\u003eسودی که اینها کردن در فروش ۸۵ میلیون بشکه نفت بالای یک میلیارد دلار بوده\u003cbr/\u003e\u003cbr/\u003eاما سؤال اصلی این نیست که نفت چطور فروخته می‌شود؛ سؤال این است که چه کسی تصمیم می‌گیرد، چه کسی تأیید می‌کند و وقتی پول برنمی‌گردد، چه کسی پاسخگوست؟\u003cbr/\u003e\u003cbr/\u003eدر این برنامه یاشار سلطانی درباره فساد در نفت و نقش \u003ca href=\"?q=%23%D9%86%D9%87%D8%A7%D8%AF%D9%87%D8%A7%DB%8C_%D8%A7%D9%85%D9%86%DB%8C%D8%AA%DB%8C\"\u003e#نهادهای_امنیتی\u003c/a\u003e در این ساختار حرف زده است.\u003cbr/\u003e\u003cbr/\u003e[ \u003ca href=\"https://youtu.be/f-IHuyXB90k?si=_vN3Cwkff3HVsCSw\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eلینک ویدیو در یوتیوب\u003c/a\u003e ]\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
