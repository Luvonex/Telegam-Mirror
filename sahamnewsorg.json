    {
      "id": 150859,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eشمار مسمومان الکلی و فوتی‌ها در نیشابور به ۷۲ نفر رسید\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eعوامل اصلی شبکه بازداشت شدند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eمعاون درمان دانشگاه علوم پزشکی نیشابور\u003cb\u003e:\u003c/b\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eشمار مسمومان الکلی نیشابور تا ظهر امروز یکشنبه اول آذرماه، به ۷۲ نفر رسیده که از این تعداد ۶۷ نفر مرد و پنج نفر زن هستند.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eتاکنون چهار مرد بر اثر مسمومیت جان خود را از دست داده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eعوامل اصلی شبکه توزیع مشروبات الکلی سمی در نیشابور بازداشت شدند./ایسنا\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
