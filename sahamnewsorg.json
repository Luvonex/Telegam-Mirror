    {
      "id": 147576,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eبا مشاهده ی⁧ \u003ca href=\"?q=%23%D8%A7%D9%86%D8%AA%D8%B5%D8%A7%D8%A8%D8%A7%D8%AA\"\u003e#انتصابات\u003c/a\u003e ⁩جدید ؛ نه تنها نشانه ای از تغییر و توسعه دیده نمی شود بلکه هشداری برای آینده و حتی بقا و موجودیت نظام به ذهن متبادر می شود!\u003cbr/\u003e\u003cbr/\u003e‏از مهره‌ ی امنیتی بدنام ؛ تا فرمانده ی سالخورده جنگی که انتقادات جدی ای بر کارنامه اش هست و وزیر سابق اقتصاد امام صادقی  صاحب گزارشات خلاف واقع و مهمل..\u003cbr/\u003e\u003cbr/\u003e‏قحط الرجالی که عامدانه نظام دچار است حاصل خالص سازی ها و برنامه ریزی های دیرین موساد در ایران است.\u003cbr/\u003e\u003cbr/\u003e‏حال باید دید آینده ی این زنگ خطر ها چه خواهد شد.\u003cbr/\u003e‏⁧ \u003ca href=\"?q=%23%D8%AE%D8%A7%D9%86%D8%AF%D9%88%D8%B2%DB%8C\"\u003e#خاندوزی\u003c/a\u003e⁩⁧ \u003ca href=\"?q=%23%D8%B3%D9%82%D9%88%D8%B7\"\u003e#سقوط\u003c/a\u003e \u003cbr/\u003e⁩ \u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
