    },
    {
      "id": 148586,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eرویترز از قول منابع آگاه:ایران 200 میلیون دلار به حزب‌الله ارسال کرد که اولین کمک از این نوع در طول جنگ بود.\u003cbr/\u003e\u003cbr/\u003eمنابعی که با رویترز صحبت کردند، اعلام کردند:\u003cbr/\u003eایران مجبور شد چهار برابر هزینه‌های معمول را برای انتقال پول به حزب‌الله بپردازد، به دلیل \u0026#34;افزایش ریسک‌ها\u0026#34;.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
