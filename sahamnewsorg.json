    },
    {
      "id": 147804,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eوقاحت در عالی ترین درجه \u003cbr/\u003e\u003cbr/\u003eعلی خامنه ای ۱۹ شهریور ۸۶: قاجار و پهلوی، ایران را فقیر، ضعیف و یک کشور درجه چندم کردند!!\u003cbr/\u003e\u003cbr/\u003eملت ایران حق دارد كه در روز قیامت و در پیش خدای متعال گریبان این ستمگران [قاجار و پهلوی] را بگیرد و ادعانامه‌ی عظیم و وحشتناكی را علیه اینها در دست بگیرد، بگوید اینها كسانی بودند كه یك كشورِ با استعداد، غنی، بزرگ، دارای آن سابقه‌ی فرهنگی بی‌نظیر را - كه چنین كشوری لااقل باید در عِداد كشورهای درجه‌ی یك جهان باشد؛ والّا اصلاً درجه‌ی یك است؛ و در بالای ستون كشورها باید قرار داشته باشد - تبدیل كردند به یك كشور درجه‌ی چندم؛ هم فقیر، هم ضعیف، هم تحقیر شده، هم توسری‌خور، هم ناامید.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-09-21T13:49:14Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 42300,
      "forwards": 0,
