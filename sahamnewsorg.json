    {
      "id": 148625,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eدرخواست پرویز ثابتی رد شد؛ پرونده شکنجه در ساواک ادامه خواهد یافت\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدادگاه فدرال در فلوریدا درخواست پرویز ثابتی، مقام ارشد پیشین ساواک، برای مختومه‌کردن پرونده شکایت علیه او را رد کرد و به این ترتیب رسیدگی قضایی به اتهامات مطرح‌شده درباره نقش او در سرکوب و شکنجه مخالفان سیاسی حکومت پهلوی ادامه خواهد یافت. \u003cbr/\u003e\u003cbr/\u003eاین پرونده از سوی شماری از ایرانیان ساکن آمریکا مطرح شده و شاکیان، ثابتی را به مشارکت و نظارت بر شکنجه زندانیان سیاسی در سال‌های پیش از انقلاب ۱۳۵۷ متهم کرده‌اند. با تصمیم اخیر دادگاه، پرونده وارد مراحل بعدی رسیدگی می‌شود و ثابتی باید در برابر ادعاهای مطرح‌شده در دادگاه فدرال پاسخگو باشد.روزاروز\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-10-08T08:44:44Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 19100,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "سهام نیوز"
    },
    {
      "id": 148626,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e\u003cb\u003eسه مسیر خروجی نفت از خلیج فارس\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C8D.png\u0026#39;)\"\u003e\u003cb\u003e✍️\u003c/b\u003e\u003c/i\u003eسلمان کدیور\u003cbr/\u003eنفت الان از سه مسیر از خلیج فارس خارج می شود\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eاول\u003c/b\u003e، دالان جنوبی. \u003cbr/\u003eاین یک دالان کم عرض در دریا است که با لایه روبی کف دریا و تراشیدن صخره های ساحلی عمان ایجاد شده است.\u003cbr/\u003eاز این مسیر کشتی های نه چندان بزرگ با اسکورت آمریکا نفت خارج می کنند و ایران هم به محض رصد به آنها شلیک می کند.\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eدوم بندر فجیره\u003c/b\u003e. (نشانگر قرمز)\u003cbr/\u003eفجیره به علت موقعیت جغرافیایی خارج از تنگه هرمز است و اعراب نفت را زمینی به آن منتقل می کنند و از آنجا بارگیری می شود.\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eمسیر سوم راه زمینی\u003c/b\u003e (مسیر فلش ها) است که با کامیون نفت را به عمان و اقیانوس هند بارگیری می کنند و از آنجا به نفتکش ها منتقل می کنند.\u003cbr/\u003e\u003cbr/\u003eج. اسلامی چند مدتی است که فجیره را هم در بانک هدف قرار داده و قصد دارد این بندر را نا امن کند. البته اگر لابی امارات در ایران اجازه دهد.\u003cbr/\u003e\u003cbr/\u003eمسیر سوم اما سخت است. بخاطر فاصله جغرافیایی و عدم تسلط منطقه ای.\u003cbr/\u003e\u003cbr/\u003eاینکه ترامپ می گوید نفت را هر روز از تنگه عبور می دهیم بیشتر از مسیر فجیره امارات و مسیر زمینی عمان است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-10-08T09:03:12Z",
