    },
    {
      "id": 148263,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eدلار از ۲۵۵ هزار تومان هم گذشت؛ خیلی از کاسب‌ها دیگر توان ادامه ندارند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eمی‌گویند بازار با فروش زنده است، اما وقتی فروش نباشد، مغازه فقط چند دیوار و یک کرکره است.\u003cbr/\u003eمغازه فکر می‌کنم.»\u003cbr/\u003e\u003cb\u003eحق ما این نبود که سال‌ها کار کنیم و آخرش به جایی برسیم که برای باز ماندن یا بستن مغازه مردد باشیم.\u003c/b\u003e\u003cbr/\u003e  \u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
