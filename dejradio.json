    {
      "id": 8236,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e نخست‌وزیر اسرائیل، بنیامین نتانیاهو، طی پیامی با تقدیر از شجاعت کاپیتان اسمیت مَچّار، خلبان هندی پرواز ۱۰۷۳ «فلای دوبی» که جان ۱۷۴ مسافر را نجات داد، او را یک «قهرمان» نامید.\u003cbr/\u003e\u003cbr/\u003eدر این پیام آمد، مَچّار «پس از آنکه در کابین خلبان با چاقو مورد حمله قرار گرفت، مقاومت کرد. او با وجود جراحات شدید، توانست درِ کابین خلبان را باز کند و به مسافران اسرائیلی و خدمه اماراتی اجازه دهد وارد شوند، مداخله کنند و جان همه مسافران را نجات دهند. \u003cbr/\u003eشجاعت فوق‌العاده آنها در کنار یکدیگر جان ۱۷۴ نفر را نجات داد. برای کاپیتان مَچّار آرزوی بهبودی کامل و سریع داریم.»\u003cbr/\u003e\u003cbr/\u003eپیش‌تر برخی منابع گزارش داده بودند خلبانان این پرواز روسی و اوکراینی بوده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D9%86%DB%8C%D8%A7%D9%85%DB%8C%D9%86_%D9%86%D8%AA%D8%A7%D9%86%DB%8C%D8%A7%D9%87%D9%88\"\u003e#بنیامین_نتانیاهو\u003c/a\u003e \u003ca href=\"?q=%23%D9%87%D9%88%D8%A7%D9%BE%DB%8C%D9%85%D8%A7%D8%B1%D8%A8%D8%A7%DB%8C%DB%8C\"\u003e#هواپیماربایی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
