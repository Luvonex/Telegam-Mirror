    {
      "id": 9428,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5841473431744287874\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9B91.png\u0026#39;)\"\u003e\u003cb\u003e🛑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eان‌بی‌سی نیوز: دولت ترامپ گزینه حملات هدفمند برای حذف مقام‌های ارشد جمهوری اسلامی را بررسی می‌کند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eشبکه ان‌بی‌سی نیوز گزارش داد که مقام‌های دولت دونالد ترامپ در حال بررسی اجرای حملات نظامی هدفمند علیه مقام‌ها و رهبران ارشد جمهوری اسلامی هستند؛ اقدامی که می‌تواند به تشدید قابل‌توجه رویارویی نظامی میان واشنگتن و تهران منجر شود.\u003cbr/\u003eبر اساس این گزارش،هدف از عملیات احتمالی،حذف چهره‌های وابسته به جناح تندرو در بالاترین سطوح ساختار قدرت جمهوری اسلامی است. منابع آگاه تأکید کرده‌اند که هنوز هیچ تصمیم نهایی در کاخ سفید یا پنتاگون اتخاذ نشده است.\u003cbr/\u003eاین بررسی‌ها در پی افزایش حملات موشکی و پهپادی جمهوری اسلامی انجام می‌شود. دونالد ترامپ روز دوشنبه اعلام کرد که تهران طی هفته گذشته شمار بی‌سابقه‌ای موشک و پهپاد شلیک کرده است؛ حملاتی که به گفته او،همگی رهگیری شده و خسارتی برجای نگذاشته‌اند.\u003cbr/\u003eاین در حالیست که هم‌زمان با افزایش تنش‌ها در تنگه هرمز و ادامه محاصره دریایی آمریکا،برخی مقام‌های ارشد جمهوری اسلامی که پیش‌تر از بیم حملات نظامی مخفی شده بودند،بار دیگر در انظار عمومی ظاهر شده‌اند.\u003cbr/\u003eاین تحولات در شرایطی رخ می‌دهد که ترامپ در گفت‌وگوی اخیر خود با فاکس‌نیوز اعلام کرده در صورت دستیابی‌نیافتن به توافق تا آغاز سال ۲۰۲۷،به ازسرگیری حملات گسترده نظامی علیه جمهوری اسلامی تمایل دارد.\u003cbr/\u003eطرح احتمال هدف قرار دادن مستقیم مقام‌های ارشد جمهوری اسلامی،در صورت تبدیل شدن به تصمیم عملیاتی،می‌تواند نشان‌دهنده تغییر مهمی در راهبرد نظامی واشنگتن باشد؛ تغییری که فشار بر ساختار رهبری رژیم را در کنار محاصره اقتصادی و تهدید به حملات گسترده قرار می‌دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
