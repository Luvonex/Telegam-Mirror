    {
      "id": 95918,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e سرخط خبرها، شامگاه سه‌شنبه ۲۶ آبان در تلویزیون ایران‌وایر\u003cbr/\u003eتلویزیون ایران‌وایر را روی ⁩ماهواره «موناکوست» (ترکمن‌عالم)\u003cbr/\u003eفرکانس ۱۰۷۶۲ افقی. سیمبل ریت سی هزار تماشا کنید.\u003cbr/\u003eنسخه اس دی را نیز می‌توانید روی فرکانس ۱۰۸۴۵ عمودی . سیمبل ریت ۲۷۵۰۰\u003cbr/\u003eدر خاورمیانه (ایران) و اروپا بگیرید.‌\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Farsi_Iranwire\" target=\"_blank\"\u003e@Farsi_Iranwire\u003c/a\u003e",
