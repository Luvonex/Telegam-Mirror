    {
      "id": 14470,
      "message": "من یک تحلیل در این مورد خواهم نوشت در ادامه",
      "date": "2026-09-13T13:28:17Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 1990,
      "forwards": 0,
      "replies": 0,
