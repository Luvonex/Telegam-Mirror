    {
      "id": 231832,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003eقیمت دلار آمریکا در ایران به ۲۳۴ هزار و ۷۰۰ تومان رسید\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E296AA.png\u0026#39;)\"\u003e\u003cb\u003e▪️\u003c/b\u003e\u003c/i\u003eبراساس آخرین به‌روزرسانی سایت بن‌بست، قیمت فروش دلار آمریکا در بازار آزاد ایران به ۲۳۴ هزار و ۷۰۰ تومان و قیمت خرید آن به ۲۳۴ هزار و ۶۰۰ تومان رسید.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AC87.png\u0026#39;)\"\u003e\u003cb\u003e⬇️\u003c/b\u003e\u003c/i\u003e بیشتر بخوانید:\u003cbr/\u003e\u003ca href=\"https://ir.voanews.com/a/8204780.html\" target=\"_blank\" rel=\"noopener\"\u003ehttps://ir.voanews.com/a/8204780.html\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/FarsiVOA\" target=\"_blank\"\u003e@FarsiVOA\u003c/a\u003e",
