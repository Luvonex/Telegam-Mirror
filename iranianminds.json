    {
      "id": 29890,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e \u003cb\u003eبیانیه جدید مجتبی خامنه‌ای:\u003cbr/\u003e\u003cbr/\u003eبراساس محاسبات الهی، جمهوری اسلامی قدرت اول جهانه.\u003c/b\u003e\u003cbr/\u003e\u003cblockquote\u003eانقلاب اسلامی روزهای تیره سلطه مستکبرین رو به روزهای پرنور جمهوری اسلامی تبدیل کرد.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eایران امروز پر از پیشرفت، عزت و استقلاله و بر اساس محاسبات الهی، قدرت اول جهانه.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمجتبی درباره سیدحسن نصرالله: از زمان انبیا و اوصیای اون‌ها، کسی به بزرگی اون در سرزمین شام ظهور نکرده بود؛ حالا پرچم حزب‌الله در دست نعیم قاسمه.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eنیروهای آمریکایی و اسرائیلی به‌دلیل ضرباتی که از رزمندگان ایران و محافظان تنگه هرمز خوردن، از دریای عرب جلوتر نمیان و به‌زودی این دریا هم از اون‌ها خالی می‌شه.\u003cbr/\u003e\u003c/blockquote\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/IranianMinds\" target=\"_blank\"\u003e@IranianMinds\u003c/a\u003e",
