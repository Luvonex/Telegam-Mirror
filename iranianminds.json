      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e وزارت امور خارجه جمهوری اسلامی:\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003eپیشنهاد دو روزه ما منطقی‌ترین ابتکار عمل در حال حاضر است و همچنان روی میز است.\u003c/blockquote\u003e\u003cbr/\u003eحالا قطر یه پیشنهاد داده:\u003cbr/\u003e\u003cblockquote\u003eبپذیرید که ج‌ا اورانیوم را تا ۳.۶۷٪ غنی‌سازی کنه.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003e۴۰۰ کیلوگرم اورانیوم غنی‌شده ۶۰٪ رو در داخل ایران رقیق کنید.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمحاصره دریایی ایران توسط امریکا رو لغو کنید.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eبخشی از دارایی‌های مسدود شده ایران (۶ تا ۱۰ میلیارد دلار) رو آزاد کنید.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eایران رو به میانجی بین عربستان سعودی و حوثی‌های یمن تبدیل کنید.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eتنگه هرمز رو پس از دید بازرسان آژانس بین‌المللی انرژی اتمی بازگشایی کنید.\u003c/blockquote\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/IranianMinds\" target=\"_blank\"\u003e@IranianMinds\u003c/a\u003e",
